<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Authentic emerald green gradient flowing 135 degrees from #018750 to #004D2C -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="135"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#018750"
                android:endColor="#004D2C"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Subtle radial center illumination -->
    <path
        android:pathData="M54,54m-42,0a42,42 0,1 1,84 0a42,42 0,1 1,-84 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="42"
                android:startColor="#20FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="radial" />
        </aapt:attr>
    </path>

</vector>
